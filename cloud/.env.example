# Local PostgreSQL; không commit file .env thật.
DATABASE_URL=postgresql+psycopg://smartparking:CHANGE_ME@localhost:5432/smartparking
SMARTPARKING_DEVICE_TOKEN=GENERATE_A_RANDOM_TOKEN_AT_LEAST_24_CHARS
ADMIN_USERNAME=admin
# Tạo bằng: python -m cloud.auth hash-password
ADMIN_PASSWORD_HASH=$argon2id$REPLACE_WITH_GENERATED_HASH
# Tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
NICEGUI_STORAGE_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARS
APP_ENV=development
SESSION_HOURS=12
RECENT_DEVICE_MINUTES=10
LOG_LEVEL=INFO
